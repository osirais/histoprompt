{
  "name": "HistoPrompt 11-label diagnosis benchmark",
  "version": 2,
  "evidence_generated_prompts_file": "prompts/evidence-generated.json",
  "comparison": {
    "baseline_strategy": "generic",
    "candidate_strategy": "evidence_generated",
    "baseline_name": "Generic prompt",
    "candidate_name": "Evidence-enriched prompt",
    "baseline_input": "Image + generic label descriptions",
    "candidate_input": "Image + frozen descriptions generated from retrieved evidence"
  },
  "report_context": {
    "scope_summary": "It evaluated 11 diagnosis labels in four clinical differentials: lung, colon, infectious esophagitis, and skin cancer.",
    "sample_note": "The exact selected image bytes are stored in the repository, and every SHA-256 checksum is verified before inference.",
    "source_note": "LC25000 images use fixed evenly spaced rows from the public dataset; infectious-esophagitis and skin-cancer images are published educational figures.",
    "coverage_gaps": [
      "This diagnosis suite has only one or two examples for several non-LC25000 labels.",
      "It does not yet cover breast, prostate, kidney, liver, brain, bone, gynecologic, or hematolymphoid diagnoses.",
      "The broad-organ replacement benchmark is pending separate PathMMU dataset approval."
    ],
    "next_steps": [
      "Add an expert-reviewed PathMMU subset after the Hugging Face account is approved for that gated dataset.",
      "Use patient-independent disease datasets with enough cases for a held-out split in every label.",
      "Keep report-writing evaluation separate from image classification accuracy."
    ]
  },
  "families": {
    "lung histopathology": {
      "prompts": {
        "benign lung tissue": "benign lung tissue with open alveolar spaces, delicate septa, bland pneumocytes, and no cytologic atypia",
        "lung adenocarcinoma": "lung adenocarcinoma with malignant gland formation, acinar or lepidic growth, atypical columnar cells, and possible mucin",
        "lung squamous cell carcinoma": "lung squamous cell carcinoma with atypical squamous nests, keratin pearls, intercellular bridges, and eosinophilic cytoplasm"
      }
    },
    "colon histopathology": {
      "prompts": {
        "benign colonic tissue": "benign colonic tissue with orderly parallel crypts, uniform goblet cells, preserved lamina propria, and no dysplasia",
        "colorectal adenocarcinoma": "colorectal adenocarcinoma with infiltrative irregular glands, hyperchromatic stratified nuclei, luminal dirty necrosis, and desmoplastic stroma"
      }
    },
    "infectious esophagitis": {
      "prompts": {
        "Candida esophagitis": "Candida esophagitis with pseudohyphae and budding yeast invading squamous epithelium with neutrophilic inflammation",
        "herpes simplex virus esophagitis": "herpes simplex virus esophagitis with multinucleated squamous cells, nuclear molding, chromatin margination, and ground-glass intranuclear inclusions",
        "cytomegalovirus esophagitis": "cytomegalovirus esophagitis with enlarged stromal or endothelial cells containing basophilic owl-eye intranuclear inclusions and clear halos"
      }
    },
    "skin cancer histopathology": {
      "prompts": {
        "basal cell carcinoma": "basal cell carcinoma with dermal islands of basaloid cells, peripheral nuclear palisading, stromal retraction, and mucinous stroma",
        "cutaneous squamous cell carcinoma": "cutaneous squamous cell carcinoma with invasive islands of pleomorphic keratinocytes, prominent nucleoli, mitotic activity, and keratinization",
        "melanoma": "melanoma with atypical pigmented melanocytes in irregular nests and single cells across the epidermis and dermis with prominent nucleoli"
      }
    }
  },
