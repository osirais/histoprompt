# Run ./scripts/setup.sh after cloning. It creates the ignored .env.local file
# and asks for credentials without storing them in Git.
LUMEN_API_KEY=
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1
# Leave blank to select the first available chat model, or pin the dashboard model id.
LUMEN_MODEL=
# Output-token limit for Lumen replies; reasoning models need more (e.g. 16000).
LUMEN_MAX_TOKENS=1400

# Hackathon path: the browser app calls the MUSK server on Delta through an
# SSH tunnel created by scripts/start_delta_tunnel.sh. These shared event
# credentials are supplied separately and are never stored in this repository.
MUSK_BACKEND=remote
MUSK_ENDPOINT=http://127.0.0.1:8801
MUSK_API_KEY=

# Post-hackathon fallback: use MUSK_BACKEND=local to download the official
# weights and run them on CUDA, Apple Silicon MPS, or CPU.
MUSK_DEVICE=auto
HF_TOKEN=
PYTORCH_ENABLE_MPS_FALLBACK=1

# Delta login used only by the tunnel script.
DELTA_USERNAME=
DELTA_MUSK_HOST=gpub055.delta.ncsa.illinois.edu
DELTA_MUSK_PORT=8001
MUSK_TUNNEL_PORT=8801

# Optional NCSA CONCH service. The hackathon supplies a separate host, port,
# and bearer key. Leave disabled until those values are posted in Slack.
CONCH_BACKEND=disabled
CONCH_ENDPOINT=http://127.0.0.1:8802
CONCH_API_KEY=
DELTA_CONCH_HOST=
DELTA_CONCH_PORT=8000
CONCH_TUNNEL_PORT=8802

# Optional additional hosted CLIP services from the same Delta node.
QUILTNET_ENDPOINT=http://127.0.0.1:8803
QUILTNET_API_KEY=
PLIP_ENDPOINT=http://127.0.0.1:8804
PLIP_API_KEY=
DELTA_QUILTNET_HOST=
DELTA_QUILTNET_PORT=8002
QUILTNET_TUNNEL_PORT=8803
DELTA_PLIP_HOST=
DELTA_PLIP_PORT=8003
PLIP_TUNNEL_PORT=8804

# App
HISTOPROMPT_HOST=127.0.0.1
HISTOPROMPT_PORT=8787
HISTOPROMPT_CORPUS=data/corpus.jsonl
# Set to 1 only for the bundled saved-output video demo. No remote services run.
HISTOPROMPT_DEMO_REPLAY=0
HISTOPROMPT_DEMO_REPLAY_PATH=data/demo_replay.json

