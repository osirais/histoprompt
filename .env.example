# Run ./scripts/setup.sh after cloning. It creates the ignored .env.local file
# and asks for credentials without storing them in Git.
LUMEN_API_KEY=
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1
# Leave blank to select the first available chat model, or pin the dashboard model id.
LUMEN_MODEL=

# Hackathon path: the browser app calls the MUSK server on Delta through an
# SSH tunnel created by scripts/start_delta_tunnel.sh. These shared event
# credentials are supplied separately and are never stored in this repository.
MUSK_BACKEND=remote
MUSK_ENDPOINT=http://127.0.0.1:8801
MUSK_API_KEY=

# Post-hackathon fallback: use MUSK_BACKEND=local to download the official
# weights and run them on CUDA, Apple Silicon MPS, or CPU.
MUSK_DEVICE=auto
HF_TOKEN=
PYTORCH_ENABLE_MPS_FALLBACK=1

# Delta login used only by the tunnel script.
DELTA_USERNAME=
DELTA_MUSK_HOST=gpub055.delta.ncsa.illinois.edu
DELTA_MUSK_PORT=8001
MUSK_TUNNEL_PORT=8801

# App
HISTOPROMPT_HOST=127.0.0.1
HISTOPROMPT_PORT=8787
HISTOPROMPT_CORPUS=data/corpus.jsonl

